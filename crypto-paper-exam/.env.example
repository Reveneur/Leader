# Bitvavo public market data does not require keys. These are only needed
# if authenticated endpoints are ever used (Exam V1 never places real orders).
BITVAVO_API_KEY=
BITVAVO_API_SECRET=

# Path to the SQLite database file.
DATABASE_PATH=data/exam_v1.sqlite

# Google Sheets export (optional — the system must run correctly without it).
GOOGLE_SHEETS_CREDENTIALS_PATH=
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_WORKSHEET_NAME=Walletlog

# Optional external data sources (Phase 3). Leave empty to run without them;
# the strategy must degrade gracefully, never block, when these are unset.
NEWS_API_KEY=
ONCHAIN_API_KEY=

# Timezone used for the exam clock.
EXAM_TIMEZONE=Europe/Amsterdam
